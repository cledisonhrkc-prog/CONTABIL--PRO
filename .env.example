# =============================================================================
# SIGC Contábil Pro — Variáveis de Ambiente
# =============================================================================

# ---------- Banco local (desenvolvimento) ----------
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# ---------- SUPABASE (produção) ----------
# Pegue essa URL em: Supabase → Project Settings → Database → Connection string → URI
# IMPORTANTE: use a "Transaction Pooler" (porta 6543) para deploy no Vercel/serverless,
# ou "Session Pooler" (porta 5432) para uso local com conexões persistentes.
#
# Formato:
# DATABASE_URL=postgresql://postgres.SEUPROJETO:SUASENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.xxxxx:sua_senha_aqui@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional: se quiser separar leitura/escrita
# DIRECT_URL=postgresql://postgres.xxxxx:sua_senha_aqui@aws-0-sa-east-1.pooler.supabase.com:5432/postgres
